+        size_t copy_len = (size_t)len < sizeof(status_line) - 1 ? (size_t)len : sizeof(status_line) - 1;
+        memcpy(status_line, data, copy_len);
+        int status = 0;
+        if (sscanf(status_line, "%*15s %d", &status) == 1) {
+            logger_log(raop->logger, LOGGER_ERR, "[PROTO] response %s status=%d", diagnostic_request, status);
+        }
+    }
     if (response_data && response_datalen > 0) {
         len -= response_datalen;

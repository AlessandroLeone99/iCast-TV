diff --git a/lib/raop.c b/lib/raop.c
--- a/lib/raop.c
+++ b/lib/raop.c
@@ -219,7 +219,25 @@
     if (!method  || !url || !protocol) {
         return;
     }
 
+    /* Fixed labels only: never include arbitrary sender URLs, headers or payloads.
+       LOGGER_ERR is used as a transport for these tagged events because the Android
+       bridge keeps verbose UxPlay logging disabled and routes the tag as INFO. */
+    const char *diagnostic_request = NULL;
+    if (!strcmp(protocol, "RTSP/1.0")) {
+        if (!strcmp(method, "SETUP")) diagnostic_request = "RTSP SETUP";
+        else if (!strcmp(method, "RECORD")) diagnostic_request = "RTSP RECORD";
+        else if (!strcmp(method, "TEARDOWN")) diagnostic_request = "RTSP TEARDOWN";
+    } else if (!strcmp(protocol, "HTTP/1.1")) {
+        if (!strcmp(url, "/server-info")) diagnostic_request = "HTTP /server-info";
+        else if (!strcmp(url, "/reverse")) diagnostic_request = "HTTP /reverse";
+        else if (!strcmp(url, "/play")) diagnostic_request = "HTTP /play";
+        else if (!strcmp(url, "/stop")) diagnostic_request = "HTTP /stop";
+        else if (!strcmp(url, "/fp-setup2")) diagnostic_request = "HTTP /fp-setup2";
+        else if (!strncmp(url, "/master.m3u8", strlen("/master.m3u8"))) diagnostic_request = "HTTP master playlist";
+    }
+    if (diagnostic_request) logger_log(raop->logger, LOGGER_ERR, "[PROTO] request %s", diagnostic_request);
+
